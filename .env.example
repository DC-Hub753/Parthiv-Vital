# Frontend demo mode. Never place backend secrets in VITE_* variables.
VITE_DEMO_MODE=true
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_VERSION=0.1.0-demo

# Backend: for hosted durable persistence, configure DATABASE_URL in the
# hosting provider's private environment settings to a managed PostgreSQL DB.
# Do not commit a real URL or credentials here.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# Local development/test fallback only (ignored SQLite file if unset).
# VITALGUARD_DB_PATH=./backend/vitalguard_demo.sqlite3

# PostgreSQL limits (optional; defaults are conservative).
# DB_CONNECT_TIMEOUT_SECONDS=5
# DB_STATEMENT_TIMEOUT_MS=10000
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT_SECONDS=10
